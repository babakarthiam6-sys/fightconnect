# --- Base de données ---
# Local  : mongodb://localhost:27017
# Atlas  : mongodb+srv://utilisateur:motdepasse@cluster.xxxxx.mongodb.net
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=fightconnect

# --- Environnement ---
# « production » active les garde-fous : l'API refuse de démarrer si JWT_SECRET
# est resté à sa valeur par défaut.
ENVIRONMENT=development

# --- Authentification ---
# Générez une valeur aléatoire : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=changez-moi-en-production
JWT_EXPIRE_MINUTES=43200

# --- Adresse publique ---
# Point de retour après l'inscription Stripe des organisateurs. Vide, elle est
# déduite de la requête, ce qui convient dans la plupart des cas.
PUBLIC_BASE_URL=

# --- Stripe (tableau de bord > Développeurs > Clés API) ---
STRIPE_SECRET_KEY=sk_test_remplacez_moi
STRIPE_PUBLISHABLE_KEY=pk_test_remplacez_moi
# Créé avec « stripe listen » ou dans Développeurs > Webhooks
STRIPE_WEBHOOK_SECRET=
CURRENCY=eur

# --- Modération IA (facultatif) ---
# Sans clé, une heuristique locale prend le relais et rien ne casse.
OPENAI_API_KEY=
OPENAI_MODERATION_MODEL=omni-moderation-latest

# --- Divers ---
# Origines autorisées, séparées par des virgules. « * » convient à une app mobile.
CORS_ORIGINS=*
# Part prélevée par la plateforme sur chaque séance (0.10 = 10 %).
# Retenue automatiquement par Stripe : le reste part sur le compte de
# l'organisateur au moment du paiement.
COMMISSION_RATE=0.10
