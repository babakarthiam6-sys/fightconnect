{
  "expo": {
    "name": "FightConnect",
    "slug": "fightconnect",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "fightconnect",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0C0C0E",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#0C0C0E"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.fightconnect.app",
      "infoPlist": {
        "NSCameraUsageDescription": "FightConnect utilise l’appareil photo pour votre photo de profil, afin qu’un partenaire sache qui il retrouve à la salle.",
        "NSPhotoLibraryUsageDescription": "FightConnect accède à vos photos pour choisir votre photo de profil.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "userInterfaceStyle": "dark",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.fightconnect.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0C0C0E"
      },
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "POST_NOTIFICATIONS"
      ],
      "userInterfaceStyle": "dark"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#0C0C0E"
    },
    "plugins": [
      "expo-router",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.fightconnect.app",
          "enableGooglePay": true
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "apiBaseUrl": "https://fightconnect-production.up.railway.app/api/v1",
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
    },
    "icon": "./assets/icon.png",
    "privacy": "public"
  }
}
