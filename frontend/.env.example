# Base URL de l'API FastAPI (sans slash final).
# En dev local sur simulateur iOS : http://localhost:8000/api/v1
# En dev local sur appareil physique : http://<IP-DE-VOTRE-MACHINE>:8000/api/v1
EXPO_PUBLIC_API_BASE_URL=https://fightconnect-prod.up.railway.app/api/v1

# Clé publique Stripe (pk_test_... en dev, pk_live_... en prod).
# La clé secrète ne doit JAMAIS se trouver dans ce fichier : elle reste côté backend.
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_remplacez_moi

# Identifiant Apple Pay (facultatif, requis seulement pour Apple Pay).
EXPO_PUBLIC_STRIPE_MERCHANT_ID=merchant.com.fightconnect.app

# Timeout des requêtes HTTP en millisecondes.
EXPO_PUBLIC_API_TIMEOUT=20000
